<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>2.7.11</version>
		<relativePath/>
	</parent>

	<groupId>com.ofb</groupId>
	<artifactId>sboot-atom-audit-services</artifactId>
	<packaging>jar</packaging>
	<version>1.0.0-ofb</version>
	<name>sboot-atom-ofb-audit-services</name>
	<description>Project OFB Audit Services</description>

	<properties>
		<!-- Project default infos -->
		<java.version>17</java.version>
		<maven.compiler.source>${java.version}</maven.compiler.source>
		<maven.compiler.target>${java.version}</maven.compiler.target>
		<project.build.sourceEnconding>UTF-8</project.build.sourceEnconding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

		<!-- Project Tican Lib dependencies-->
		<ofb-lib-common-tools-version>1.0.0</ofb-lib-common-tools-version>
		<ofb-lib-autoconfigure-amqp-version>1.0.0</ofb-lib-autoconfigure-amqp-version>
		<ofb-lib-autoconfigure-handlers-version>1.0.0</ofb-lib-autoconfigure-handlers-version>
		<ofb-lib-autoconfigure-interceptors-version>1.0.0</ofb-lib-autoconfigure-interceptors-version>
		<ofb-lib-autoconfigure-security-version>1.0.0</ofb-lib-autoconfigure-security-version>

		<!-- additional information used in <goal>build-info</goal> -->
		<info.additional.project.module.name>OFB.AUDIT.SERVICES</info.additional.project.module.name>
		<info.additional.contact.name>fras200627</info.additional.contact.name>
		<info.additional.contact.url>*</info.additional.contact.url>
		<info.additional.contact.email>fras200627@gmail.com</info.additional.contact.email>
		<info.additional.license.name>fras200627</info.additional.license.name>
		<info.additional.license.url>*</info.additional.license.url>

		<!-- Project Core Dependencies -->
		<org.springframework.cloud.version>2021.0.8</org.springframework.cloud.version>

		<spring-security-oauth2-authorization-server-version>1.5.0</spring-security-oauth2-authorization-server-version>
		<resilience4j-spring-boot2-version>1.7.0</resilience4j-spring-boot2-version>
		<org.mapstruct.version>1.6.3</org.mapstruct.version>
		<mysql-connector-java-version>8.0.33</mysql-connector-java-version>
		<lombok.version>1.18.36</lombok.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-dependencies</artifactId>
				<version>${org.springframework.cloud.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<dependency>
			<groupId>com.ofb</groupId>
			<artifactId>ofb-lib-common-tools</artifactId>
			<version>${ofb-lib-common-tools-version}</version>
		</dependency>
		<dependency>
			<groupId>com.ofb</groupId>
			<artifactId>ofb-lib-autoconfigure-amqp</artifactId>
			<version>${ofb-lib-autoconfigure-amqp-version}</version>
		</dependency>
		<dependency>
			<groupId>com.ofb</groupId>
			<artifactId>ofb-lib-autoconfigure-handlers</artifactId>
			<version>${ofb-lib-autoconfigure-handlers-version}</version>
		</dependency>
		<dependency>
			<groupId>com.ofb</groupId>
			<artifactId>ofb-lib-autoconfigure-interceptors</artifactId>
			<version>${ofb-lib-autoconfigure-interceptors-version}</version>
		</dependency>
		<dependency>
			<groupId>com.ofb</groupId>
			<artifactId>ofb-lib-autoconfigure-security</artifactId>
			<version>${ofb-lib-autoconfigure-security-version}</version>
		</dependency>

		<!-- Spring core dependencies -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<!-- Spring Cloud -->
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
		</dependency>

		<!-- Spring Data -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!-- Spring Test -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
		</dependency>

		<!-- Spring Cloud Backend Circuit-Breaker Services -->
		<dependency>
			<groupId>io.github.resilience4j</groupId>
			<artifactId>resilience4j-spring-boot2</artifactId>
			<version>${resilience4j-spring-boot2-version}</version>
		</dependency>

		<!-- JDBC Data Drivers -->
		<dependency>
			<groupId>mysql</groupId>
			<artifactId>mysql-connector-java</artifactId>
			<version>${mysql-connector-java-version}</version>
		</dependency>

		<!-- Lombok -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<version>${lombok.version}</version>
			<scope>provided</scope>
		</dependency>

		<!-- MapStruct -->
		<dependency>
			<groupId>org.mapstruct</groupId>
			<artifactId>mapstruct</artifactId>
			<version>${org.mapstruct.version}</version>
		</dependency>
		<dependency>
			<groupId>org.mapstruct</groupId>
			<artifactId>mapstruct-processor</artifactId>
			<version>${org.mapstruct.version}</version>
		</dependency>
	</dependencies>

	<build>
	<plugins>
		<!-- Runs the Lombok and MapStruct Processors required for lombok.* annotations and created 'MapStruct' mappers. -->
		<plugin>
			<groupId>org.apache.maven.plugins</groupId>
			<artifactId>maven-compiler-plugin</artifactId>
			<configuration>
				<annotationProcessorPaths>
					<path>
						<groupId>org.mapstruct</groupId>
						<artifactId>mapstruct-processor</artifactId>
						<version>1.6.3</version>
					</path>
					<path>
						<groupId>org.projectlombok</groupId>
						<artifactId>lombok</artifactId>
						<version>1.18.36</version>
					</path>
					<path>
						<groupId>org.projectlombok</groupId>
						<artifactId>lombok-mapstruct-binding</artifactId>
						<version>0.2.0</version>
					</path>
				</annotationProcessorPaths>
			</configuration>
		</plugin>

		<plugin>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-maven-plugin</artifactId>
			<executions>
				<execution>
					<id>build-info</id>
					<goals>
						<goal>build-info</goal>
					</goals>
					<configuration>
						<additionalProperties>
							<project.module.name>${info.additional.project.module.name}</project.module.name>
							<project.title>${project.name}</project.title>
							<project.description>${project.description}</project.description>
							<project.version>${java.version}</project.version>
							<contact.name>${info.additional.contact.name}</contact.name>
							<contact.url>${info.additional.contact.url}</contact.url>
							<contact.email>${info.additional.contact.email}</contact.email>
							<license.name>${info.additional.license.name}</license.name>
							<license.url>${info.additional.license.url}</license.url>
						</additionalProperties>
					</configuration>
				</execution>
			</executions>
		</plugin>
	</plugins>
	</build>
</project>
