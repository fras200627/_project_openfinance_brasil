<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>2.7.11</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>

	<groupId>com.ofb</groupId>
	<artifactId>sbatch-ofb-consents-approval-control</artifactId>
	<version>1.0.0-ofb</version>
	<packaging>jar</packaging>
	<name>sbatch-ofb-consents-approval-control</name>
	<description>Sbatch Consents Approval Control</description>

	<properties>
		<!-- Project default infos -->
		<java.version>17</java.version>
		<maven.compiler.source>${java.version}</maven.compiler.source>
		<maven.compiler.target>${java.version}</maven.compiler.target>
		<project.build.sourceEnconding>UTF-8</project.build.sourceEnconding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

		<!-- Project OFB Lib dependencies-->
		<ofb-lib-common-tools-version>1.0.0</ofb-lib-common-tools-version>
		<ofb-lib-autoconfigure-amqp-version>1.0.0</ofb-lib-autoconfigure-amqp-version>
		<ofb-lib-autoconfigure-handlers-version>1.0.0</ofb-lib-autoconfigure-handlers-version>
		<ofb-lib-autoconfigure-interceptors-version>1.0.0</ofb-lib-autoconfigure-interceptors-version>
		<ofb-lib-autoconfigure-security-version>1.0.0</ofb-lib-autoconfigure-security-version>

		<!-- additional information used in <goal>build-info</goal> -->
		<info.additional.project.module.name>BATCH.CONSENTS.APPROVAL.CONTROL</info.additional.project.module.name>
		<info.additional.contact.name>fras200627</info.additional.contact.name>
		<info.additional.contact.url>*</info.additional.contact.url>
		<info.additional.contact.email>fras200627@gmail.com</info.additional.contact.email>
		<info.additional.license.name>fras200627</info.additional.license.name>
		<info.additional.license.url>*</info.additional.license.url>

		<!-- Project Core Dependencies -->
		<org.springframework.cloud.version>2021.0.8</org.springframework.cloud.version>

		<spring-security-oauth2-authorization-server-version>0.2.3</spring-security-oauth2-authorization-server-version>
		<mysql-version>8.0.33</mysql-version>
		<oracle-version>23.8.0.25.04</oracle-version>
		<lombok.version>1.18.36</lombok.version>

		<!-- Settings dependencies for the OpenAPI generator and Swagger-UI-->
		<openapi-springdoc-version>1.8.0</openapi-springdoc-version>
		<openapi-code-generator-version>7.12.0</openapi-code-generator-version>

		<!-- Required dependencies for the OpenAPI generator -->
		<io.swagger.core.v3.version>2.2.21</io.swagger.core.v3.version>
		<nimbus-jose-jwt.version>9.22</nimbus-jose-jwt.version>
		<gson-version>2.10.1</gson-version>
		<gson-fire-version>1.9.0</gson-fire-version>
		<okhttp-version>4.12.0</okhttp-version>
		<jackson-databind-nullable-version>0.2.6</jackson-databind-nullable-version>
		<junit-jupiter-engine-version>5.8.2</junit-jupiter-engine-version>
		<javax.annotation.version>1.3.2</javax.annotation.version>
		<javax-validation-api-version>2.0.1.Final</javax-validation-api-version>
		<org.apache.oltu.oauth2.client.version>1.0.2</org.apache.oltu.oauth2.client.version>
		<com.google.code.findbugs.version>3.0.2</com.google.code.findbugs.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-dependencies</artifactId>
				<version>${org.springframework.cloud.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<!-- Lib dependencies-->
		<dependency>
			<groupId>com.ofb</groupId>
			<artifactId>sboot-lib-ofb-common-tools</artifactId>
			<version>${ofb-lib-common-tools-version}</version>
		</dependency>
		<dependency>
			<groupId>com.ofb</groupId>
			<artifactId>sboot-lib-ofb-autoconfigure-amqp</artifactId>
			<version>${ofb-lib-autoconfigure-amqp-version}</version>
		</dependency>
		<dependency>
			<groupId>com.ofb</groupId>
			<artifactId>sboot-lib-ofb-autoconfigure-handlers</artifactId>
			<version>${ofb-lib-autoconfigure-handlers-version}</version>
		</dependency>
		<dependency>
			<groupId>com.ofb</groupId>
			<artifactId>sboot-lib-ofb-autoconfigure-interceptors</artifactId>
			<version>${ofb-lib-autoconfigure-interceptors-version}</version>
		</dependency>
		<dependency>
			<groupId>com.ofb</groupId>
			<artifactId>sboot-lib-ofb-autoconfigure-security</artifactId>
			<version>${ofb-lib-autoconfigure-security-version}</version>
		</dependency>

		<!-- Spring core dependencies -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-batch</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<!-- Spring Cloud -->
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
		</dependency>

		<!-- JDBC Data Drivers -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>mysql</groupId>
			<artifactId>mysql-connector-java</artifactId>
			<version>${mysql-version}</version>
		</dependency>
		<dependency>
			<groupId>com.oracle.database.jdbc</groupId>
			<artifactId>ojdbc11</artifactId>
			<version>${oracle-version}</version>
		</dependency>

		<!-- Lombok -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<version>${lombok.version}</version>
			<scope>provided</scope>
		</dependency>

		<!-- SWAGGER-UI:: SpringDoc and Swagger UI resources -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-ui</artifactId>
			<version>${openapi-springdoc-version}</version>
		</dependency>

		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-engine</artifactId>
			<version>${junit-jupiter-engine-version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-api</artifactId>
		</dependency>
		<dependency>
			<groupId>org.assertj</groupId>
			<artifactId>assertj-core</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.batch</groupId>
			<artifactId>spring-batch-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>build-info</id>
						<goals>
							<goal>build-info</goal>
						</goals>
						<configuration>
							<additionalProperties>
								<project.module.name>${info.additional.project.module.name}</project.module.name>
								<project.title>${project.name}</project.title>
								<project.description>${project.description}</project.description>
								<project.version>${java.version}</project.version>
								<contact.name>${info.additional.contact.name}</contact.name>
								<contact.url>${info.additional.contact.url}</contact.url>
								<contact.email>${info.additional.contact.email}</contact.email>
								<license.name>${info.additional.license.name}</license.name>
								<license.url>${info.additional.license.url}</license.url>
							</additionalProperties>
						</configuration>
					</execution>
				</executions>
			</plugin>

		</plugins>
	</build>

</project>
