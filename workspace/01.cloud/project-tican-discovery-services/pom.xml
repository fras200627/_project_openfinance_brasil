<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>2.7.11</version>
	</parent>

	<groupId>com.tican</groupId>
	<artifactId>tican-discovery-services</artifactId>
	<packaging>jar</packaging>
	<version>1.0.0-openapi</version>
	<name>tican-discovery-services</name>
	<description>Project Tican Discovery Services</description>

	<properties>
		<!-- default builder infos -->
		<java.version>17</java.version>
		<maven.compiler.source>${java.version}</maven.compiler.source>
		<maven.compiler.target>${java.version}</maven.compiler.target>
		<project.build.sourceEnconding>UTF-8</project.build.sourceEnconding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

		<!-- Necessary to avoid conflicts with OpenAPI -->
<!--		<start-class>com.tican.discovery.services.StartApplication</start-class>-->

		<!-- additional information used in <goal>build-info</goal> -->
		<info.additional.project.module.name>DISCOVERY.SERVICES</info.additional.project.module.name>
		<info.additional.contact.name>fras200627</info.additional.contact.name>
		<info.additional.contact.url>*</info.additional.contact.url>
		<info.additional.contact.email>fras200627@gmail.com</info.additional.contact.email>
		<info.additional.license.name>fras200627</info.additional.license.name>
		<info.additional.license.url>*</info.additional.license.url>

		<!-- Settings dependencies for the OpenAPI generator and Swagger-UI-->
		<openapi-springdoc-version>1.8.0</openapi-springdoc-version>
		<openapi-code-generator-version>7.12.0</openapi-code-generator-version>

		<exclude.generate.sources.tests>${project.build.directory}/generated-sources/server/src/test/java/org</exclude.generate.sources.tests>
		<exclude.generate.sources.org>${project.build.directory}/generated-sources/server/src/main/java/org</exclude.generate.sources.org>

		<!-- Necessary in OpenAPI Generator Tool and Generated Classes -->
		<gson-version>2.10.1</gson-version>
		<gson-fire-version>1.9.0</gson-fire-version>
		<okhttp-version>4.12.0</okhttp-version>
		<commons-lang3-version>3.14.0</commons-lang3-version>
		<jackson-databind-nullable-version>0.2.6</jackson-databind-nullable-version>
		<jakarta-annotation-version>1.3.5</jakarta-annotation-version>
		<junit-version>5.10.3</junit-version>
		<junit-platform-runner.version>1.10.0</junit-platform-runner.version>
		<jakarta.ws.rs-api-version>2.1.6</jakarta.ws.rs-api-version>
		<jsr311-api-version>1.1.1</jsr311-api-version>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<spotless.version>2.43.0</spotless.version>
		<javax.annotation.version>1.3.2</javax.annotation.version>

		<!-- Necessary in mapper objects -->
		<org.mapstruct.version>1.6.3</org.mapstruct.version>
		<lombok.mapstruct.binding.version>0.2.0</lombok.mapstruct.binding.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-dependencies</artifactId>
				<version>2021.0.8</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-netflix-eureka-server</artifactId>
		</dependency>

		<!-- Spring defaults -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<scope>provided</scope>
		</dependency>

		<!-- MapStruct -->
		<dependency>
			<groupId>org.mapstruct</groupId>
			<artifactId>mapstruct</artifactId>
			<version>${org.mapstruct.version}</version>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok-mapstruct-binding</artifactId>
			<version>${lombok.mapstruct.binding.version}</version>
		</dependency>

		<!-- SWAGGER-UI:: SpringDoc and Swagger UI resources -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-ui</artifactId>
			<version>${openapi-springdoc-version}</version>
		</dependency>

		<!-- Necessary in OpenAPI Generator Tool and Generated Classes -->
		<dependency>
			<groupId>javax.annotation</groupId>
			<artifactId>javax.annotation-api</artifactId>
			<version>${javax.annotation.version}</version>
		</dependency>
		<dependency>
			<groupId>com.google.code.findbugs</groupId>
			<artifactId>jsr305</artifactId>
			<version>3.0.2</version>
		</dependency>
		<dependency>
			<groupId>com.squareup.okhttp3</groupId>
			<artifactId>okhttp</artifactId>
			<version>${okhttp-version}</version>
		</dependency>
		<dependency>
			<groupId>com.squareup.okhttp3</groupId>
			<artifactId>logging-interceptor</artifactId>
			<version>${okhttp-version}</version>
		</dependency>
		<dependency>
			<groupId>com.google.code.gson</groupId>
			<artifactId>gson</artifactId>
			<version>${gson-version}</version>
		</dependency>
		<dependency>
			<groupId>io.gsonfire</groupId>
			<artifactId>gson-fire</artifactId>
			<version>${gson-fire-version}</version>
		</dependency>
		<dependency>
			<groupId>org.apache.oltu.oauth2</groupId>
			<artifactId>org.apache.oltu.oauth2.client</artifactId>
			<version>1.0.2</version>
		</dependency>
		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-lang3</artifactId>
			<version>${commons-lang3-version}</version>
		</dependency>
		<dependency>
			<groupId>jakarta.annotation</groupId>
			<artifactId>jakarta.annotation-api</artifactId>
			<version>${jakarta-annotation-version}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.openapitools</groupId>
			<artifactId>jackson-databind-nullable</artifactId>
			<version>${jackson-databind-nullable-version}</version>
		</dependency>
		<dependency>
			<groupId>jakarta.ws.rs</groupId>
			<artifactId>jakarta.ws.rs-api</artifactId>
			<version>${jakarta.ws.rs-api-version}</version>
		</dependency>

		<!-- Necessary in OpenAPI Test dependencies -->
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-engine</artifactId>
			<version>${junit-version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.platform</groupId>
			<artifactId>junit-platform-runner</artifactId>
			<version>${junit-platform-runner.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-api</artifactId>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- removes unwanted test class instances and classes from /main/src/java/?/org/openapi generated by Generate.OpenAPI. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-antrun-plugin</artifactId>
				<executions>
					<execution>
						<phase>process-sources</phase>
						<goals>
							<goal>run</goal>
						</goals>
						<configuration>
							<target>
								<delete dir="${exclude.generate.sources.tests}" />
								<delete dir="${exclude.generate.sources.org}" />
							</target>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>org.openapitools</groupId>
				<artifactId>openapi-generator-maven-plugin</artifactId>
				<version>${openapi-code-generator-version}</version>
				<executions>
					<execution>
						<id>generator-api-health-checks</id> <!-- It is not optional and must have a unique id -->
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<!--+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
							 generatorName Types:
							 OpenAPI Documentation for API Servers and API Clients in
							 https://openapi-generator.tech/docs/generators/
							 The 'spring' type generates a server package ++++++++++++++-->
							<generatorName>spring</generatorName>
							<skipValidateSpec>true</skipValidateSpec>
							<inputSpec>${project.basedir}/src/main/resources/openapi/server/api-health-checks.yaml</inputSpec>
							<generatorName>spring</generatorName>
							<apiPackage>com.tican.discovery.services.server.handler</apiPackage>
							<modelPackage>com.tican.discovery.services.server.model</modelPackage>
							<supportingFilesToGenerate>ApiUtil.java</supportingFilesToGenerate>
							<output>target/generated-sources/server</output>
							<!--++++++++++++++++++++++++++++++++++++++++++++++++++++++++-->
							<skipValidateSpec>true</skipValidateSpec>
							<configOptions>
								<delegatePattern>true</delegatePattern>
								<requestMappingMode>controller</requestMappingMode> <!-- Default -->
								<dateLibrary>java8</dateLibrary>
								<useBeanValidation>true</useBeanValidation>
								<performBeanValidation>true</performBeanValidation>
								<openApiNullable>true</openApiNullable>
								<documentationProvider>springdoc</documentationProvider>
								<library>spring-boot</library>
								<useSpringBoot3>false</useSpringBoot3>
								<generateBuilders>true</generateBuilders>
								<generateConstructorWithAllArgs>true</generateConstructorWithAllArgs>
								<generatedConstructorWithRequiredArgs>true</generatedConstructorWithRequiredArgs>
							</configOptions>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>build-info</id>
						<goals>
							<goal>build-info</goal>
						</goals>
						<configuration>
							<additionalProperties>
								<project.module.name>${info.additional.project.module.name}</project.module.name>
								<project.title>${project.name}</project.title>
								<project.description>${project.description}</project.description>
								<project.version>${java.version}</project.version>
								<contact.name>${info.additional.contact.name}</contact.name>
								<contact.url>${info.additional.contact.url}</contact.url>
								<contact.email>${info.additional.contact.email}</contact.email>
								<license.name>${info.additional.license.name}</license.name>
								<license.url>${info.additional.license.url}</license.url>
							</additionalProperties>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
