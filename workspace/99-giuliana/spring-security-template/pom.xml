<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>2.7.11</version>
		<relativePath /> <!-- lookup parent from repository -->
	</parent>
	
	<groupId>com.spring.security</groupId>
	<artifactId>spring-security-template</artifactId>
	<version>1.0.0</version>
	<name>spring.security-template</name>
	<description>Spring Security Template</description>
	
	<properties>
		<!-- default builder infos -->
		<java.version>17</java.version>
		<maven.compiler.source>${java.version}</maven.compiler.source>
		<maven.compiler.target>${java.version}</maven.compiler.target>
		<project.build.sourceEnconding>UTF-8</project.build.sourceEnconding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

		<!-- Necessary to avoid conflicts with OpenAPI -->
		<!--		<start-class>com.ofb.authentication.StartApplication</start-class>-->

		<!-- additional information used in <goal>build-info</goal> -->
		<info.additional.project.module.name>AUTH.SERVER</info.additional.project.module.name>
		<info.additional.contact.name>fras200627</info.additional.contact.name>
		<info.additional.contact.url>*</info.additional.contact.url>
		<info.additional.contact.email>fras200627@gmail.com</info.additional.contact.email>
		<info.additional.license.name>fras200627</info.additional.license.name>
		<info.additional.license.url>*</info.additional.license.url>

		<exclude.generate.sources.tests>${project.build.directory}/generated-sources/server/src/test/java/org</exclude.generate.sources.tests>
		<exclude.generate.sources.org>${project.build.directory}/generated-sources/server/src/main/java/org</exclude.generate.sources.org>

		<!-- Project Core Dependencies -->
		<org.springframework.cloud.version>2021.0.8</org.springframework.cloud.version>
		<resilience4j-spring-boot2-version>1.7.0</resilience4j-spring-boot2-version>
		<org.mapstruct.version>1.6.3</org.mapstruct.version>
		<mysql-connector-java-version>8.0.33</mysql-connector-java-version>
		<lombok.version>1.18.36</lombok.version>

		<!-- Settings dependencies for the OpenAPI generator and Swagger-UI-->
		<openapi-springdoc-version>1.8.0</openapi-springdoc-version>
		<openapi-code-generator-version>7.12.0</openapi-code-generator-version>

		<!-- Required dependencies for the OpenAPI generator -->
		<gson-version>2.10.1</gson-version>
		<gson-fire-version>1.9.0</gson-fire-version>
		<okhttp-version>4.12.0</okhttp-version>
		<jackson-databind-nullable-version>0.2.6</jackson-databind-nullable-version>
		<junit-jupiter-engine-version>5.8.2</junit-jupiter-engine-version>
		<javax.annotation.version>1.3.2</javax.annotation.version>
		<javax-validation-api-version>2.0.1.Final</javax-validation-api-version>
		<org.apache.oltu.oauth2.client.version>1.0.2</org.apache.oltu.oauth2.client.version>
		<com.google.code.findbugs.version>3.0.2</com.google.code.findbugs.version>
	</properties>
	
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
		</dependency>
		
		<!-- Spring Data -->
		<dependency>
			<groupId>mysql</groupId>
			<artifactId>mysql-connector-java</artifactId>
			<version>${mysql-connector-java-version}</version>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>


	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-antrun-plugin</artifactId>
				<executions>
					<execution>
						<phase>process-sources</phase>
						<goals>
							<goal>run</goal>
						</goals>
						<configuration>
							<target>
								<delete dir="${exclude.generate.sources.tests}" />
								<delete dir="${exclude.generate.sources.org}" />
							</target>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>