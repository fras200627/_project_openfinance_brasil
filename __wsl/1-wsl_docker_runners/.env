# SPRING.PROFILE.ACTIVE #################################################
PROFILE_ACTIVE = 'docker'
# 
# DOCKER ENVIRONMENT SETTINGS ###########################################
DOCKER_DOMAIN_NAME = 'domain-ofb-services'
API_NAMESPACE      = 'OFB Services'
API_NAMESPACE_TITLE= 'OFB Services Engine'
# 
# APPS RUN SETTINGS ################################################
API_LOGGING_LEVEL     = info
API_SWAGGER_ENABLE    = true
API_JPA_SHOW_SQL      = true
API_HIBERNATE_DDL_AUTO= none
# 
# MY-SQL SERVICE ##########################################################
MYSQL_IMAGE         = 'mysql:8.0'
MYSQL_HOST_NAME     = 'db-mysql-svc'
MYSQL_HOST_IP       = '10.0.1.100'
MYSQL_INTERNAL_PORT = 3306
MYSQL_EXPOSE_PORT   = 3306
MYSQL_EXTERNAL_PORT = 13306
MYSQL_USER          = 'root'
MYSQL_PWD           = 'ofb'
MYSQL_ROOT_PWD      = 'ofb'
MYSQL_DATA_VOLUME   = '/opt/containerd/volume-docker/mysql/mysqldata'
MYSQL_BACKUP_VOLUME = '/opt/containerd/volume-docker/mysql/mysqlbackup'
#
# ORACLE XE SERVICE ##########################################################
ORACLEXE_IMAGE       = 'gvenzl/oracle-xe'
ORACLEXE_HOST_NAME   = 'db-oracle-svc'
ORACLE_HOST_IP       = '10.0.1.101'
ORACLE_INTERNAL_PORT = 1521
ORACLE_EXPOSE_PORT   = 1521
ORACLE_EXTERNAL_PORT = 1523
ORACLE_USER          = sys
ORACLE_SYS_PWD       = tican
ORACLE_TICAN_USER    = tican
ORACLE_TICAN_USER_PWD= tican
ORACLE_SID           = XE
ORACLE_DATA_VOLUME   = '/opt/containerd/volume-docker/oracle/oradata'
ORACLE_BACKUP_VOLUME = '/opt/containerd/volume-docker/oracle/backup'
#
# RABBIT-MQ ##########################################################
RABBITMQ_IMAGE     = 'rabbitmq:3-management'
RABBITMQ_HOST_NAME = 'mq-rabbit-svc'
RABBITMQ_HOST_IP   = '10.0.1.102'
RABBITMQ_SERVICE_INTERNAL_PORT   = 5672
RABBITMQ_SERVICE_EXPOSE_PORT     = 5672
RABBITMQ_CLUSTER_INTERNAL_PORT   = 5673
RABBITMQ_CLUSTER_EXPOSE_PORT     = 5673
RABBITMQ_DASHBOARD_INTERNAL_PORT = 15672
RABBITMQ_DASHBOARD_EXPOSE_PORT   = 15672
RABBITMQ_DASHBOARD_EXTERNAL_PORT = 17672
RABBITMQ_DEFAULT_USER  = 'ofb'
RABBITMQ_DEFAULT_PWD   = 'ofb'
RABBITMQ_DATA_VOLUME   = '/opt/containerd/volume-docker/rabbitmq/rabbitmqdata'
RABBITMQ_BACKUP_VOLUME = '/opt/containerd/volume-docker/rabbitmq/rabbitmqbackup'
# 
# Discovery Services Application variables
DISCOVERY_SERVICES_IMAGE         = 'fras200627/sboot-atom-ofb-discovery-services:1.0.0'
DISCOVERY_SERVICES_HOST_NAME     = 'ofb-discovery-services'
DISCOVERY_SERVICES_APP_NAME      = 'ofb-discovery-services'
DISCOVERY_SERVICES_HOST_IP       = '10.0.1.1'
DISCOVERY_SERVICES_INTERNAL_PORT = 3000
DISCOVERY_SERVICES_EXPOSE_PORT   = 3000
DISCOVERY_SERVICES_EXTERNAL_PORT  = 5000
DISCOVERY_SERVICES_DATA_VOLUME   = '/opt/containerd/volume-docker/discovery-services/discoveryservicesdata'
DISCOVERY_SERVICES_BACKUP_VOLUME = '/opt/containerd/volume-docker/discovery-services/discoveryservicesbackup'
# 
# API Gateway Application variables
API_GATEWAY_IMAGE         = 'fras200627/sboot-atom-ofb-api-gateway:1.0.0'
API_GATEWAY_HOST_NAME     = 'ofb-api-gateway'
API_GATEWAY_APP_NAME      = 'ofb-api-gateway'
API_GATEWAY_HOST_IP       = '10.0.1.2'
API_GATEWAY_INTERNAL_PORT = 3001
API_GATEWAY_EXPOSE_PORT   = 3001
API_GATEWAY_EXTERNAL_PORT = 5001
API_GATEWAY_DATA_VOLUME   = '/opt/containerd/volume-docker/api_gateway/apigatewaydata'
API_GATEWAY_BACKUP_VOLUME = '/opt/containerd/volume-docker/api_gateway/apigatewaybackup'
# 
# Authentication Server variables
AUTHENTICATION_SERVER_IMAGE         = 'fras200627/sboot-atom-ofb-authentication-server:1.0.0'
AUTHENTICATION_SERVER_HOST_NAME     = 'ofb-authentication-server'
AUTHENTICATION_SERVER_APP_NAME      = 'ofb-authentication-server'
AUTHENTICATION_SERVER_HOST_IP       = '10.0.1.3'
AUTHENTICATION_SERVER_INTERNAL_PORT = 3013
AUTHENTICATION_SERVER_EXPOSE_PORT   = 3013
AUTHENTICATION_SERVER_DATA_VOLUME   = '/opt/containerd/volume-docker/authentication_server/authserverdata'
AUTHENTICATION_SERVER_BACKUP_VOLUME = '/opt/containerd/volume-docker/authentication_server/authserverbackup'
AUTH_JKS_KEYPASS   = '123456'
AUTH_JKS_STOREPASS = '123456'
AUTH_JKS_ALIAS     = 'tican'
AUTH_JKS_PATH      = 'keystore/tican.jks'
# 
# Authentication Server variables
AUTHORIZATION_SERVER_IMAGE         = 'fras200627/sboot-atom-ofb-authorization-server:1.0.0'
AUTHORIZATION_SERVER_HOST_NAME     = 'ofb-authorization-server'
AUTHORIZATION_SERVER_APP_NAME      = 'ofb-authorization-server'
AUTHORIZATION_SERVER_HOST_IP       = '10.0.1.4'
AUTHORIZATION_SERVER_INTERNAL_PORT = 3011
AUTHORIZATION_SERVER_EXPOSE_PORT   = 3011
AUTHORIZATION_SERVER_DATA_VOLUME   = '/opt/containerd/volume-docker/authorization_server/authserverdata'
AUTHORIZATION_SERVER_BACKUP_VOLUME = '/opt/containerd/volume-docker/authorizaation_server/authserverbackup'
# 