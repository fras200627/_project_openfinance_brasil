# SPRING.PROFILE.ACTIVE #################################################
# PROFILE_ACTIVE = 'docker'
# 
# DOCKER ENVIRONMENT SETTINGS ###########################################
# DOCKER_DOMAIN_NAME = 'domain-tican-services'
# API_NAMESPACE      = 'Tican Services'
# API_NAMESPACE_TITLE= 'Tican Services Engine'
# 
# TICAN APPS RUN SETTINGS ################################################
# API_LOGGING_LEVEL     = info
# API_SWAGGER_ENABLE    = true
# API_JPA_SHOW_SQL      = true
# API_HIBERNATE_DDL_AUTO= none
# 
# FOREIGN KEYS APPS ######################################################
# URI_OAUTH2_REGISTERED_CLIENTS_BUSINESS_API = 'tican-oauth2-registered-clients-business-api'
# URI_OAUTH2_REGISTERED_CLIENTS_DOMAIN_API   = 'tican-oauth2-registered-clients-domain-api'
# URI_OAUTH2_USERS_BUSINESS_API              = 'tican-oauth2-users-business-api'
# URI_OAUTH2_USERS_DOMAIN_API                = 'tican-oauth2-users-domain-api'
# URI_MEDICAL_SUBSTANCES_DOMAIN_API          = 'tican-medical-substances-domain-api'
# URI_MEDICAL_SUBSTANCES_BUSINESS_API        = 'tican-medical-substances-business-api'
# URI_MEDICAL_PRODUCTS_BUSINESS_API          = 'tican-medical-products-business-api'
# URI_MEDICAL_PRODUCTS_DOMAIN_AP             = 'tican-medical-products-domain-api'
# URI_AUDIT_SERVICES_API                     = 'tican-audit-services-api'
# 
# MY-SQL SERVICE ##########################################################
MYSQL_IMAGE         = 'mysql:8.0'
MYSQL_HOST_NAME     = 'MySQL80'
MYSQL_HOST_IP       = '10.0.1.100'
MYSQL_INTERNAL_PORT = 3306
MYSQL_EXPOSE_PORT   = 3306
MYSQL_EXTERNAL_PORT = 13306
MYSQL_USER          = 'root'
MYSQL_PWD           = 'tican'
MYSQL_ROOT_PWD      = 'tican'
MYSQL_ROOT_PASSWORD = 'root'
MYSQL_DATA_VOLUME   = '/opt/containerd/volume-docker/mysqldata'
MYSQL_BACKUP_VOLUME = '/opt/containerd/volume-docker/mysqlbackup'

